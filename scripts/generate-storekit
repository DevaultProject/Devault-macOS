#!/bin/bash
# 로컬 StoreKit 테스트 스토어를 붙여 워크스페이스를 생성한다.
#
# Projects/Devault/Devault.storekit 이 있어야 한다. 이 파일은 git으로 추적되지 않으므로
# 팀에서 별도로 전달받아 그 경로에 두고 실행한다.
#
# 주의: 실행 스킴이 수정되므로 Devault.xcscheme 에 diff가 생긴다. 커밋하지 말 것.
#       원래대로 돌리려면 `tuist generate` 를 다시 실행한다.
set -e

cd "$(dirname "$0")/.."

if [ ! -f "Projects/Devault/Devault.storekit" ]; then
  echo "error: Projects/Devault/Devault.storekit 이 없습니다. 팀에서 파일을 받아 그 경로에 두세요." >&2
  exit 1
fi

TUIST_STORE_KIT_TESTING=1 tuist generate "$@"
